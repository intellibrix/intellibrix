{
  "name": "intellibrix-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "AI-Powered Software Component Framework (monorepo)",
  "author": "Jay Mathis <code@mathis.network>",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs": "node scripts/docs.mjs",
    "changeset": "changeset",
    "check:packages": "bash scripts/check-packages.sh",
    "check:api": "pnpm --filter intellibrix api:check",
    "smoke:examples": "node scripts/smoke-examples.mjs",
    "scaffold:local": "bash scripts/scaffold-local.sh",
    "docs:site": "node scripts/docs.mjs && pnpm --filter intellibrix-website build:site && node scripts/assemble-site.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@microsoft/api-extractor": "^7.59.4",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
