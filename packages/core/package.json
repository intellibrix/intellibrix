{
  "name": "intellibrix",
  "version": "0.1.22",
  "description": "AI-Powered Software Component Framework",
  "author": "Jay Mathis <code@mathis.network>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellibrix/intellibrix.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/intellibrix/intellibrix#readme",
  "bugs": {
    "url": "https://github.com/intellibrix/intellibrix/issues"
  },
  "keywords": [
    "intellibrix",
    "agent",
    "llm",
    "framework",
    "typescript",
    "tools",
    "ai"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api:check": "api-extractor run -c api-extractor.index.json && api-extractor run -c api-extractor.testing.json",
    "api:update": "api-extractor run -c api-extractor.index.json --local && api-extractor run -c api-extractor.testing.json --local"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "ajv": "^8.20.0",
    "cron": "^4.4.0",
    "pino": "^8.14.1",
    "pino-pretty": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
